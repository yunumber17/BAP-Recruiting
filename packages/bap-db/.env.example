# Copy to .env and fill in. For Supabase, use the pooled (pgBouncer) URL for the
# app runtime and the direct URL for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/bap?schema=public"

# Supabase example:
# DATABASE_URL="postgresql://postgres.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres"
